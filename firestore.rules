rules_version = '2';

/**
 * กฎความปลอดภัยของ Firestore สำหรับ APEX ELEVEN
 *
 * หลักการ:
 *   • accounts/{uid} — เซฟทั้งก้อน (เหรียญ, คลังการ์ด, ทีม) เจ้าของเท่านั้นที่แตะได้
 *   • profiles/{uid} — ข้อมูลสาธารณะสำหรับตารางอันดับและจับคู่
 *     ใครก็ตามที่ล็อกอินแล้วอ่านได้ แต่เขียนได้เฉพาะแถวของตัวเอง
 *   • config/{doc}   — ค่าตั้งของเกมที่เจ้าของโปรเจคกำหนด (การ์ดรางวัล, ประกาศ, คำสั่งรีเซ็ต)
 *     ทุกคนอ่านได้ เขียนได้เฉพาะเจ้าของโปรเจค (ดู isProjectOwner ข้างล่าง)
 *   • gifts/{uid}    — กล่องของขวัญ เจ้าของโปรเจคหย่อนของให้ผู้เล่น เจ้าของกล่องรับแล้วลบทิ้ง
 *
 * นำไปใช้: Firebase Console → Firestore Database → Rules → วางทับ → Publish
 * หรือใช้ CLI: firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /** เจ้าของเอกสารเท่านั้น */
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /** ล็อกอินแล้ว (ไม่ว่าจะเป็นใคร) */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * ═══════════════════════════════════════════════════════════
     *  uid ของเจ้าของโปรเจค — ใส่ของคุณเองตรงนี้
     * ═══════════════════════════════════════════════════════════
     * ดู uid ได้จากในเกม: ล็อกอินด้วยไอดีที่อยู่ใน OWNER_USERNAMES
     * (src/data/rankRewards.ts) → หน้า Leaderboard → ปุ่ม "ตั้งค่ารางวัล"
     * → uid จะแสดงอยู่มุมล่างซ้ายของหน้าต่าง ก๊อปมาวางในรายการนี้ได้เลย
     * ใส่ได้หลายคน คั่นด้วยจุลภาค เช่น ['uidA', 'uidB']
     */
    function isProjectOwner() {
      return isSignedIn() && request.auth.uid in ['9VJpo6W12MOiMZdW3gLgmyR0KAp2'];
    }

    /*
     * ═══════════════════════════════════════════════════════════
     *  เพดานอัตราการโตของดาว (กันโปรแกรมโกงยัดดาว)
     * ═══════════════════════════════════════════════════════════
     * เกมนี้จำลองผลแมตช์ที่เครื่องผู้เล่น เซิร์ฟเวอร์จึงไม่มีทางรู้ว่าแมตช์นั้น
     * เกิดขึ้นจริงไหม สิ่งที่ทำได้คือคุม "ความเร็ว" ที่ดาวโตได้ ให้อยู่ในระดับที่
     * เล่นจริงเท่านั้นถึงจะทำได้ — ยัดทีเดียวหลายพันดาวจึงถูกปฏิเสธที่เซิร์ฟเวอร์
     *
     * สูตร: ดาวที่เพิ่มได้ ≤ BURST + (นาทีที่ผ่านไปตั้งแต่ดาวขยับครั้งล่าสุด)
     *   BURST เผื่อไว้ให้คนที่หายไปนานแล้วกลับมา ลีกจะคิดผลย้อนหลังทีเดียวหลายรอบ
     *   ส่วนตัวหารนาทีทำให้คนที่ยิงคำขอรัว ๆ ได้ดาวเพิ่มแทบไม่ขึ้นเลย
     *
     * ดาวลดลงได้เสมอ (แพ้ / โดนแอดมินรีเซ็ต) และการแก้ชื่อทีม/รูป/ตัวจริง
     * โดยไม่แตะดาว ก็ผ่านตามปกติ ไม่ถูกจำกัด
     */
    function pointsBurst() {
      return 60;
    }

    /** ดาวที่เพิ่มขึ้นในคำขอนี้ */
    function pointsGain() {
      return request.resource.data.points - resource.data.points;
    }

    /** นาทีที่ผ่านไปตั้งแต่ดาวขยับครั้งล่าสุด (ตามนาฬิกาเซิร์ฟเวอร์) */
    function minutesSincePoints() {
      return (request.time.toMillis() - resource.data.pointsUpdatedAt.toMillis()) / 60000;
    }

    /*
     * ═══════════════════════════════════════════════════════════
     *  ดาวเป็นของเซิร์ฟเวอร์ (ใช้คู่กับ Cloud Functions)
     * ═══════════════════════════════════════════════════════════
     * เปิดใช้เมื่อ deploy functions และตั้ง VITE_SERVER_AUTHORITY=1 แล้วเท่านั้น
     * เปลี่ยน SERVER_OWNS_POINTS เป็น true แล้วเครื่องผู้เล่นจะแก้ดาวไม่ได้เลย
     * (Admin SDK ที่ Cloud Functions ใช้ข้ามกฎทั้งหมดอยู่แล้ว จึงเขียนได้ฝ่ายเดียว)
     *
     * ⚠️ ห้ามเปิดก่อน deploy functions — ลีกกับ Matchmaking จะเขียนเซฟไม่ผ่านแล้วเกมพัง
     * ลำดับที่ถูกต้อง: deploy functions → VITE_SERVER_AUTHORITY=1 → ทดสอบว่าลงแข่งได้
     * → ค่อยเปลี่ยนค่านี้เป็น true แล้ว publish
     *
     * ปิดอยู่ (false) = ใช้เพดานอัตราการโตของดาวแทน (ดู pointsRateOk)
     */
    function serverOwnsPoints() {
      return false;
    }

    /** ดาวและสถิติแพ้-ชนะต้องไม่ขยับเลยในคำขอที่มาจากเครื่องผู้เล่น */
    function pointsUnchanged() {
      return request.resource.data.points == resource.data.points
        && request.resource.data.get('wins', 0) == resource.data.get('wins', 0)
        && request.resource.data.get('draws', 0) == resource.data.get('draws', 0)
        && request.resource.data.get('losses', 0) == resource.data.get('losses', 0);
    }

    /** ดาวโตเร็วเกินที่เล่นจริงจะทำได้ไหม */
    function pointsRateOk() {
      return
        // ไม่ได้แตะดาว หรือดาวลดลง = ผ่านเลย
        request.resource.data.points <= resource.data.points
        // ดาวเพิ่ม: ต้องประทับเวลาจากเซิร์ฟเวอร์ และห้ามโตเกินเพดาน
        || (
             request.resource.data.pointsUpdatedAt == request.time
             && (
                  // เอกสารเก่าที่ยังไม่มีเวลาประทับ — ปล่อยผ่านครั้งเดียวเพื่อให้เริ่มนับได้
                  !('pointsUpdatedAt' in resource.data)
                  || pointsGain() <= pointsBurst() + minutesSincePoints()
                )
           );
    }

    /**
     * เซฟทั้งก้อนของผู้เล่นหนึ่งคน — อ่าน/เขียนได้เฉพาะเจ้าของบัญชี
     *
     * เปิดโหมดเซิร์ฟเวอร์แล้ว ฟิลด์ที่เป็นของเซิร์ฟเวอร์ต้องไม่ขยับเลย
     * (ดาว · คู่แข่งที่เพิ่งเจอ · เวลาลงแข่งล่าสุด · สถานะลีก)
     * ฝั่งหน้าเว็บตัดฟิลด์เหล่านี้ออกก่อนเขียนอยู่แล้ว — ดู SERVER_OWNED_STATE_FIELDS
     * ใน src/services/firebase/cloudAccount.ts ทั้งสองที่ต้องตรงกันเสมอ
     *
     * Firestore แบบ merge จะคงค่าเดิมของฟิลด์ที่ไม่ได้ส่งมา กฎนี้จึงผ่านตามปกติ
     */
    match /accounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if false;

      allow update: if isOwner(uid) && (!serverOwnsPoints() || accountServerFieldsUnchanged());
    }

    /** ฟิลด์ในเซฟที่มีแต่เซิร์ฟเวอร์เท่านั้นที่แก้ได้ */
    function accountServerFieldsUnchanged() {
      return request.resource.data.state.get('record', {}) == resource.data.state.get('record', {})
        && request.resource.data.state.get('league', {}) == resource.data.state.get('league', {})
        && request.resource.data.state.get('recentRivals', []) == resource.data.state.get('recentRivals', [])
        && request.resource.data.state.get('lastMatchAt', '') == resource.data.state.get('lastMatchAt', '');
    }

    match /profiles/{uid} {
      allow read: if isSignedIn();

      /*
       * เจ้าของโปรเจคเขียนโปรไฟล์ของทุกคนได้ — ใช้ตอนสั่งรีเซ็ตดาวทั้งกระดาน
       * เอกสารนี้เป็นข้อมูลสาธารณะ (ชื่อทีม/ค่าพลัง/ดาว) ไม่มีเหรียญหรือคลังการ์ดอยู่ในนี้
       * ส่วน accounts/{uid} ยังล็อกไว้ที่เจ้าของบัญชีคนเดียวเหมือนเดิม
       */
      allow write: if isProjectOwner();

      // เขียนได้เฉพาะโปรไฟล์ของตัวเอง (กันคนไปแก้ดาวของคนอื่น)
      // สร้างโปรไฟล์ครั้งแรก — บัญชีใหม่ต้องเริ่มจากดาวน้อย ๆ ไม่ใช่โผล่มาพร้อมหลักพัน
      allow create: if isOwner(uid)
        && isValidProfile(uid)
        && request.resource.data.points <= pointsBurst();

      /*
       * แก้โปรไฟล์ของตัวเอง (ชื่อทีม รูป ตัวจริง ค่าพลัง)
       *   เปิดโหมดเซิร์ฟเวอร์ = ห้ามแตะดาวเด็ดขาด
       *   ยังไม่เปิด = ดาวโตได้ไม่เกินอัตราที่เล่นจริงทำได้
       */
      allow update: if isOwner(uid)
        && isValidProfile(uid)
        && (serverOwnsPoints() ? pointsUnchanged() : pointsRateOk());
    }

    /** รูปแบบข้อมูลที่ยอมรับได้ของโปรไฟล์สาธารณะ (กันการยัดค่าประหลาดลงตารางอันดับ) */
    function isValidProfile(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.teamOvr is number
        && request.resource.data.teamOvr >= 0
        && request.resource.data.teamOvr <= 120
        && request.resource.data.teamName is string
        && request.resource.data.teamName.size() <= 40
        && request.resource.data.managerName is string
        && request.resource.data.managerName.size() <= 40
        // ตัวจริงที่เปิดให้คนอื่นดู — ได้ไม่เกิน 11 ช่องตามจำนวนผู้เล่นในสนาม
        // (บัญชีเก่าที่ยังไม่เคยประกาศจะไม่มีฟิลด์นี้ จึงต้องยอมให้ไม่มีได้)
        && (!('squad' in request.resource.data) || request.resource.data.squad.size() <= 11)
        /*
         * รูปโปรไฟล์เก็บเป็น data URL ในเอกสารนี้เลย (ไม่ได้ใช้ Firebase Storage)
         * เอกสารนี้ทุกคนโหลดพร้อมตารางอันดับ 100 แถว จึงต้องคุมขนาดให้เข้ม
         * 60,000 ตัวอักษร ≈ 45 KB — พอสำหรับรูป 112px ที่ย่อแล้ว แต่ยัดรูปเต็มความละเอียดไม่ได้
         * ค่านี้ต้องตรงกับ AVATAR_MAX_CHARS ใน src/services/avatar.ts
         */
        && (!('avatar' in request.resource.data) || (
             request.resource.data.avatar is string
             && request.resource.data.avatar.size() <= 60000
           ));
    }

    /**
     * กล่องผลการแข่ง: A เขียนใบรายงานลงกล่องของ B ได้ แต่แค่ "หย่อนใบใหม่" เท่านั้น
     *   • เจ้าของกล่องเท่านั้นที่อ่านและลบได้
     *   • ผู้ส่งต้องเซ็นชื่อตัวเอง (fromUid) และส่งให้คนอื่นเท่านั้น ส่งให้ตัวเองไม่ได้
     *   • แก้ใบที่ส่งไปแล้วไม่ได้ (allow update: if false) กันการย้อนกลับไปแก้สกอร์
     *   • สกอร์และค่าพลังต้องอยู่ในช่วงที่เป็นไปได้ กันการยัดเลขมั่ว ๆ
     *
     * หมายเหตุ: ตัวเลขรางวัล (เหรียญ/คะแนน) ไม่ได้ส่งมาในใบ — ฝั่งผู้รับคำนวณเองเสมอ
     * ผู้ส่งจึงกำหนดได้แค่สกอร์ ซึ่งถูกจำกัดช่วงไว้แล้วทั้งในกฎนี้และในโค้ดฝั่งรับ
     */
    match /matchInbox/{uid}/items/{reportId} {
      allow read, delete: if isOwner(uid);
      allow update: if false;

      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != uid
        && request.resource.data.teamScore is number
        && request.resource.data.teamScore >= 0
        && request.resource.data.teamScore <= 20
        && request.resource.data.opponentScore is number
        && request.resource.data.opponentScore >= 0
        && request.resource.data.opponentScore <= 20
        && request.resource.data.fromTeamOvr is number
        && request.resource.data.fromTeamOvr >= 0
        && request.resource.data.fromTeamOvr <= 120
        && request.resource.data.toTeamOvr is number
        && request.resource.data.toTeamOvr >= 0
        && request.resource.data.toTeamOvr <= 120
        && request.resource.data.fromTeamName is string
        && request.resource.data.fromTeamName.size() <= 40
        && request.resource.data.fromManagerName is string
        && request.resource.data.fromManagerName.size() <= 40;
    }

    /**
     * ค่าตั้งของเกมที่เจ้าของโปรเจคกำหนดเอง (ตอนนี้มีเอกสารเดียว: rankRewards)
     * ผู้เล่นทุกคนต้องอ่านได้ เพราะหน้า Leaderboard โชว์การ์ดรางวัลชุดเดียวกันทั้งเซิร์ฟเวอร์
     *
     * rankRewards เก็บแค่รายการ id ของการ์ด 10 ใบ (อันดับ 1 → 10)
     * จำกัดความยาวไว้กันการยัดข้อมูลก้อนใหญ่ลงเอกสารที่ทุกคนต้องโหลด
     */
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isProjectOwner()
        // rankRewards — รายการ id การ์ด 10 ใบ
        && (!('cards' in request.resource.data) || request.resource.data.cards.size() <= 20)
        // announcement — ความยาวต้องตรงกับ ANNOUNCEMENT_MAX_CHARS ใน src/services/admin.ts
        && (!('message' in request.resource.data) || (
             request.resource.data.message is string
             && request.resource.data.message.size() <= 1200
           ))
        // ladder — สัดส่วนดาวที่เก็บไว้ต้องอยู่ระหว่าง 0–1 และซีซันต้องยาวอย่างน้อย 1 วัน
        && (!('keep' in request.resource.data) || (
             request.resource.data.keep is number
             && request.resource.data.keep >= 0
             && request.resource.data.keep <= 1
           ))
        && (!('seasonDays' in request.resource.data) || (
             request.resource.data.seasonDays is number
             && request.resource.data.seasonDays >= 1
             && request.resource.data.seasonDays <= 365
           ));
    }

    /**
     * กล่องของขวัญ: เจ้าของโปรเจคหย่อนของให้ผู้เล่น
     *   • เจ้าของกล่องเท่านั้นที่อ่านและลบได้ (ลบ = รับของเข้าบัญชีเรียบร้อยแล้ว)
     *   • หย่อนใบใหม่ได้เฉพาะเจ้าของโปรเจค · แก้ใบที่หย่อนไปแล้วไม่ได้
     *   • จำนวนถูกจำกัดช่วงไว้ กันพิมพ์เลขพลาดจนเงินเฟ้อทั้งเซิร์ฟเวอร์
     *     (ค่านี้ต้องตรงกับ GIFT_MAX_AMOUNT / GIFT_MAX_CARDS ใน src/services/firebase/gifts.ts)
     */
    match /gifts/{uid}/items/{giftId} {
      allow read, delete: if isOwner(uid);
      allow update: if false;

      allow create: if isProjectOwner()
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 100000000
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points <= 100000000
        && request.resource.data.upgradePoints is number
        && request.resource.data.upgradePoints >= 0
        && request.resource.data.upgradePoints <= 100000000
        && request.resource.data.cardPlayerIds.size() <= 30
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200;
    }

    // ที่เหลือปิดหมด — เปิดเฉพาะเท่าที่เกมใช้จริง
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
